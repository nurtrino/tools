# Copy this file to ".env" and fill in your keys.
# Only FINNHUB_API_KEY is required for the quantitative pillars to work.

# Finnhub — free key at https://finnhub.io/register
FINNHUB_API_KEY=

# Financial Modeling Prep — named analyst ratings + price targets for the consensus
# panel (key at https://site.financialmodelingprep.com/). Optional: without it (or if
# the plan paywalls the endpoints) the app falls back to Finnhub's anonymized counts.
FMP_API_KEY=

# FRED (macro) — free key at https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Anthropic (Claude) — for the thesis narrative + qualitative extraction.
# Optional: if blank, the tool still produces the rating + scorecard, just no AI narrative.
ANTHROPIC_API_KEY=
# Cheapest capable model for this workload. Swap to claude-opus-4-8 for higher quality.
ANTHROPIC_MODEL=claude-haiku-4-5

# SEC EDGAR requires a descriptive User-Agent with contact info (their policy).
SEC_USER_AGENT=PublicCompanyAnalyser/1.0 (cb@huizengacapital.com)
